/* --- Estilos Globais e Variáveis --- */
:root {
    --bg-color: #0b0f19;
    --card-bg: rgba(22, 29, 47, 0.85);
    --primary-color: #3b82f6;
    --accent-color: #06b6d4;
    --success-color: #10b981;
    --warning-color: #f59e0b;
    --danger-color: #ef4444;
    --text-primary: #f3f4f6;
    --text-secondary: #9ca3af;
    --border-color: rgba(255, 255, 255, 0.1);
    --font-sans: 'Inter', sans-serif;
    --font-mono: 'Fira Code', monospace;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
}

/* --- Canvas de Animação de Fundo --- */
#network-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
}

/* --- App Layout --- */
.app-container {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px;
}

/* --- Cabeçalho --- */
.main-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    backdrop-filter: blur(10px);
    margin-bottom: 25px;
    flex-wrap: wrap;
    gap: 15px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo .icon {
    font-size: 2rem;
}

.logo h1 {
    font-size: 1.4rem;
    color: #fff;
}

.logo p {
    font-size: 0.85rem;
    color: var(--text-secondary);
}

.main-nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.nav-btn {
    color: var(--text-secondary);
    text-decoration: none;
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: all 0.3s;
}

.nav-btn:hover, .nav-btn.active {
    background: rgba(59, 130, 246, 0.2);
    color: var(--accent-color);
}

/* --- Seções e Cards --- */
.section-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 25px;
    margin-bottom: 25px;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.section-card h2 {
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: 5px;
}

.subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 20px;
}

/* --- Seção de Cenários --- */
.scenarios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.scenario-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    padding: 12px 15px;
    border-radius: 8px;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    transition: all 0.3s;
    text-align: left;
}

.scenario-btn:hover {
    background: rgba(59, 130, 246, 0.15);
    border-color: var(--primary-color);
}

.scenario-btn.active {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
    font-weight: 600;
}

/* --- Detalhes do Cenário --- */
.scenario-detail-box {
    background: rgba(0, 0, 0, 0.3);
    border-left: 4px solid var(--accent-color);
    padding: 20px;
    border-radius: 0 8px 8px 0;
}

.detail-block {
    margin-bottom: 18px;
}

.detail-block:last-child {
    margin-bottom: 0;
}

.detail-block h3 {
    font-size: 1rem;
    color: var(--accent-color);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.detail-block p, .detail-block ul {
    font-size: 0.95rem;
    color: var(--text-primary);
}

.detail-block ul {
    list-style-type: disc;
    padding-left: 20px;
}

.code-badge {
    background: rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    padding: 2px 6px;
    border-radius: 4px;
    color: #38bdf8;
    font-size: 0.85rem;
}

/* --- Terminal Simulado --- */
.terminal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.badge {
    background: rgba(16, 185, 129, 0.2);
    color: var(--success-color);
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    border: 1px solid var(--success-color);
}

.terminal-window {
    background: #050811;
    border: 1px solid #1e293b;
    border-radius: 8px;
    font-family: var(--font-mono);
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.5);
}

.terminal-topbar {
    background: #0f172a;
    padding: 8px 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid #1e293b;
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
}

.dot.red { background: var(--danger-color); }
.dot.yellow { background: var(--warning-color); }
.dot.green { background: var(--success-color); }

.terminal-title {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-left: 10px;
}

.terminal-body {
    padding: 15px;
    min-height: 220px;
    max-height: 320px;
    overflow-y: auto;
    font-size: 0.88rem;
    color: #e2e8f0;
}

.terminal-body p {
    margin-bottom: 4px;
    white-space: pre-wrap;
    word-break: break-all;
}

.terminal-input-line {
    display: flex;
    align-items: center;
    padding: 10px 15px;
    background: #090d16;
    border-top: 1px solid #1e293b;
}

.prompt-symbol {
    color: var(--success-color);
    font-size: 0.85rem;
    margin-right: 8px;
    white-space: nowrap;
}

#terminal-input {
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    width: 100%;
}

/* --- Guia de Comandos --- */
.commands-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
}

.cmd-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    padding: 15px;
    border-radius: 8px;
}

.cmd-card code {
    color: var(--accent-color);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    display: block;
    margin-bottom: 8px;
}

.cmd-card p {
    font-size: 0.88rem;
    color: var(--text-primary);
    margin-bottom: 8px;
}

.cmd-card small {
    color: var(--text-secondary);
    font-size: 0.78rem;
}

/* --- Quiz --- */
.quiz-box {
    background: rgba(0, 0, 0, 0.2);
    padding: 18px;
    border-radius: 8px;
}

.quiz-question {
    font-size: 0.95rem;
    margin-bottom: 12px;
}

.quiz-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 15px;
}

.quiz-option {
    font-size: 0.9rem;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.04);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: 0.2s;
}

.quiz-option:hover {
    border-color: var(--primary-color);
}

.action-btn {
    background: var(--primary-color);
    color: #fff;
    border: none;
    padding: 9px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    transition: 0.3s;
}

.action-btn:hover {
    background: #2563eb;
}

.quiz-result-message {
    margin-top: 12px;
    font-weight: 600;
    font-size: 0.9rem;
}

.quiz-result-message.success { color: var(--success-color); }
.quiz-result-message.error { color: var(--danger-color); }

/* --- Rodapé --- */
.main-footer {
    text-align: center;
    padding: 15px;
    color: var(--text-secondary);
    font-size: 0.8rem;
}
